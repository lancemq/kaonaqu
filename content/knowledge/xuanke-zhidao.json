    {
      "type": "element", "tag": "section", "className": "chapter",
      "children": [
        { "type": "element", "tag": "h2", "className": "section-title", "children": [{ "type": "text", "text": "第1单元 · “3+3”到底怎么考" }] },
        { "type": "element", "tag": "p", "className": "section-lead", "children": [{ "type": "text", "text": "上海高考实行“3+3”模式：语文、数学、外语为必考（每科 150 分），再从物理、化学、生物、历史、地理、政治 6 门中自主选择 3 门作为等级考，计入高考总分。" }] },
        { "type": "element", "tag": "div", "className": "concept-grid", "children": [
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "必考 3 科" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "语文、数学、外语各 150 分，原始分计入；外语有两次考试机会（含听说测试），可取较高成绩。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "等级考 3 科" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "6 门中自选 3 门，成绩按全市排名折算为 11 级等第（A+ 到 E），对应 70—40 分计入总分，体现“分数+排位”。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "总分构成" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "660 分 = 语数外 450 + 等级考 3 科（最高 210）。选科直接决定你能报哪些专业组，是高考前最重要的决策之一。" }] }
          ]}
        ]},
        { "type": "element", "tag": "aside", "className": "important", "children": [
          { "type": "element", "tag": "h5", "className": "callout-title", "children": [{ "type": "text", "text": "决策逻辑" }] },
          { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "选科不是“哪科分高选哪科”，而是“兴趣能力 × 专业志向 × 学校优势”的交集。先用专业倒推选科，再结合自身成绩，最后看本校师资与往年等级考表现。" }] }
        ]}
      ]
    },
    {
      "type": "element", "tag": "section", "className": "chapter",
      "children": [
        { "type": "element", "tag": "h2", "className": "section-title", "children": [{ "type": "text", "text": "第2单元 · 选科组合与专业匹配" }] },
        { "type": "element", "tag": "p", "className": "section-lead", "children": [{ "type": "text", "text": "高校专业对选科有明确要求。近年趋势是理工农医类普遍要求“物理+化学”绑定，人文社科类限制较少。" }] },
        { "type": "element", "tag": "div", "className": "concept-grid", "children": [
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "物化绑定" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "覆盖绝大多数理工、医学、农林专业组。若志向是计算机、电子信息、临床医学等，基本必选“物理+化学”，第三门再按兴趣（如生物/地理）。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "物生地 / 物地政" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "保留物理、避开化学，可报部分工科与地理、环境类专业，但医学、化工等受限；适合物理强但化学弱的学生。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "史地政（全文）" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "对应人文、法学、语言、管理、教育等专业组，专业覆盖面广但理工科完全关闭；适合擅长记忆表达、志在社科的学生。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "化生政 / 生史地" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "偏生物/医学相关但非临床方向（如生物科学、药学、食品），或环境与地学；需对照目标院校专业组的具体要求逐条核对。" }] }
          ]}
        ]},
        { "type": "element", "tag": "aside", "className": "mistakes", "children": [
          { "type": "element", "tag": "h5", "className": "callout-title", "children": [{ "type": "text", "text": "易错" }] },
          { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "① 只看当下分数不看专业要求，高三发现想报的专业组“不够格”；② 盲目跟风“热门组合”忽视自身优势；③ 忽略目标院校《招生专业目录》逐年微调；④ 高一未体验就草率定档。" }] }
        ]}
      ]
    },
    {
      "type": "element", "tag": "section", "className": "chapter",
      "children": [
        { "type": "element", "tag": "h2", "className": "section-title", "children": [{ "type": "text", "text": "第3单元 · 合格考是什么、考哪些" }] },
        { "type": "element", "tag": "p", "className": "section-lead", "children": [{ "type": "text", "text": "合格考（学业水平合格性考试）面向高中所有开设科目，达标是毕业与参加对应等级考的前提；它不计入高考总分，但“一票否决”选考资格。" }] },
        { "type": "element", "tag": "div", "className": "concept-grid", "children": [
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "覆盖科目" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "语文、数学、外语、物理、化学、生物、历史、地理、政治、信息科技、通用技术、艺术（音乐/美术）、体育与健身等，基本覆盖高中全部课程。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "合格考作用" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "① 取得高中毕业资格；② 所选 3 门等级考科目必须先通过对应合格考；③ 未通过可补考，但不影响已选科目的等级考报名前提需先合格。" }] }
          ]},
          { "type": "element", "tag": "div", "className": "concept-card", "children": [
            { "type": "element", "tag": "h4", "children": [{ "type": "text", "text": "仅合格考科目" }] },
            { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "信息科技、通用技术、艺术等一般只设合格考、不设等级考；即使不选为等级考科目，也须合格方能毕业，平时不能“完全放弃”。" }] }
          ]}
        ]},
        { "type": "element", "tag": "aside", "className": "important", "children": [
          { "type": "element", "tag": "h5", "className": "callout-title", "children": [{ "type": "text", "text": "合格考与等级考关系" }] },
          { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "合格考是“达标线”，等级考是“选拔线”。先确保合格考全科通过（拿毕业证+解锁选考），再把精力集中到 3 门等级考上冲高分；非选考科目合格即可，不必过度投入。" }] }
        ]}
      ]
    },
    {
      "type": "element", "tag": "section", "className": "chapter",
      "children": [
        { "type": "element", "tag": "h2", "className": "section-title", "children": [{ "type": "text", "text": "第4单元 · 选科决策四步法" }] },
        { "type": "element", "tag": "p", "className": "section-lead", "children": [{ "type": "text", "text": "把“凭感觉”变成“可验证”的流程，减少高三反悔成本。" }] },
        { "type": "element", "tag": "ol", "className": "topic-stats", "children": [
          { "type": "element", "tag": "li", "children": [{ "type": "text", "text": "列专业：结合兴趣与职业想象，圈定 2—3 个专业大类，查其选科要求。" }] },
          { "type": "element", "tag": "li", "children": [{ "type": "text", "text": "对成绩：对照高一各科排名，排除明显弱势，保留有竞争力的科目。" }] },
          { "type": "element", "tag": "li", "children": [{ "type": "text", "text": "看学校：了解本校各组合开班情况与师资，优先选“本校强”的组合。" }] },
          { "type": "element", "tag": "li", "children": [{ "type": "text", "text": "定组合：在高二前锁定 3 门等级考，合格考全科保底，避免中途切换。" }] }
        ]},
        { "type": "element", "tag": "aside", "className": "mistakes", "children": [
          { "type": "element", "tag": "h5", "className": "callout-title", "children": [{ "type": "text", "text": "易错" }] },
          { "type": "element", "tag": "p", "children": [{ "type": "text", "text": "① 完全听家长/老师而忽视自我适配；② 为“避开某老师”换组合因小失大；③ 高三才发现目标专业要求“物化”却未选；④ 把合格考科目彻底弃考导致无法毕业。" }] }
        ]}
      ]
    },
    {
      "type": "element", "tag": "aside", "className": "exam",
      "children": [
        { "type": "element", "tag": "div", "className": "exam-meta", "children": [
          { "type": "element", "tag": "span", "className": "exam-tag", "children": [{ "type": "text", "text": "选科情景" }] },
          { "type": "element", "tag": "span", "className": "exam-tag points", "children": [{ "type": "text", "text": "决策" }] }
        ]},
        { "type": "element", "tag": "h4", "className": "exam-title", "children": [{ "type": "text", "text": "想报“临床医学”专业组，应如何选科？" }] },
        { "type": "element", "tag": "p", "className": "exam-q", "children": [{ "type": "text", "text": "【思路】临床医学普遍要求“物理+化学”双选，部分还要求生物；稳妥组合为“物化政/物化生”。确定后须保证这三门合格考通过，并把等级考精力集中于此三科。" }] }
      ]
    },
    {
      "type": "element", "tag": "p", "className": "source",
      "children": [{ "type": "text", "text": "参考：上海市深化高等学校考试招生综合改革实施方案、普通高校招生专业目录选考科目要求" }]
    }
  ],
